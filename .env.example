# ==========================================================================
# MARIA FÃƒS - variaveis de ambiente
# Copie para `.env` e preencha. NUNCA versione o `.env`.
# ==========================================================================

# --- Servidor -------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# URL publica da aplicacao (usada em links de convite, reset de senha e push)
PUBLIC_URL=http://localhost:3000
# --- HTTPS de desenvolvimento (celular na rede local) ----------------------
# Camera, microfone, WebRTC e LIVE exigem contexto seguro: sem HTTPS o
# navegador nem cria `navigator.mediaDevices`. Gere o certificado com
#   node scripts/dev-cert.mjs
# (ele cobre localhost e o IP da maquina) e descomente as linhas abaixo,
# trocando o IP em PUBLIC_URL pelo da maquina. Certificados ficam em .certs/
# e NUNCA sao versionados nem servidos ao frontend.
# TLS_CERT_PATH=.certs/dev-cert.pem
# TLS_KEY_PATH=.certs/dev-key.pem
# TLS_CA_PATH=.certs/ca.crt
# Origens autorizadas para CORS (separadas por virgula). Vazio = mesma origem.
CORS_ORIGINS=

# --- Segredos (gere com: npm run keys) ------------------------------------
# Segredo de assinatura de sessao/cookies. Gere um novo valor unico.
SESSION_SECRET=
# Quantidade de rodadas do scrypt para hash de senha
SCRYPT_COST=16384

# --- Banco ----------------------------------------------------------------
DATABASE_PATH=./data/pulse.db

# --- Storage --------------------------------------------------------------
STORAGE_ROOT=./storage

# --- Midia (ffmpeg) --------------------------------------------------------
# Caminho do executavel ffmpeg. Se vazio, tenta `ffmpeg` do PATH e depois
# o binario empacotado em node_modules/ffmpeg-static.
FFMPEG_PATH=
# Duracao maxima de video em segundos
MAX_VIDEO_DURATION=600
# Tamanho maximo de upload de video em bytes
MAX_VIDEO_BYTES=104857600
MAX_IMAGE_BYTES=20971520
MAX_AUDIO_BYTES=20971520
MAX_FILE_BYTES=52428800
# Habilita transcoding/HLS multi-resolucao (requer ffmpeg)
MEDIA_TRANSCODE=true
MEDIA_HLS=true

# --- LIVE / WebRTC --------------------------------------------------------
# Servidores STUN (padrao publico do Google).
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN e NECESSARIO para atravessar NAT restritivo, 4G/5G e rede corporativa.
# Sem TURN a LIVE so funciona onde o STUN descobre o endereco publico.
#
# Cadastre um servidor real (coturn e o mais comum) e informe aqui. A
# aplicacao aceita tres formatos, separando varios por virgula:
#
#   TURN_URL=turn:meu.turn.exemplo:3478?transport=udp
#   TURN_URL=turns:meu.turn.exemplo:5349?transport=tcp
#   TURN_URLS=turn:meu.turn.exemplo:3478?transport=udp,turns:meu.turn.exemplo:5349?transport=tcp
#   TURN_URL=turn:meu.turn.exemplo:3478?transport=udp  (usa TURN_USERNAME/CREDENTIAL)
#   TURN_URL=usuario:senha@meu.turn.exemplo:3478      (coturn gera assim)
#
# PrefiraUDP + TLS na 443: em rede corporativa so o TLS passa. A entrada sem
# credencial e DESCARTADA de proposito - e melhor nao oferecer um TURN inutil
# do que fingir que a LIVE esta pronta.
#
# As credenciais ficam SO no servidor: o frontend recebe a lista de ICE pelo
# endpoint autenticado de configuracao da LIVE e nunca le variavel de ambiente.
TURN_URL=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
#
# ---- CREDENCIAL EFEMERA (recomendado, item 3) --------------------------
# Com TURN_SECRET, o servidor NAO entrega o usuario/senha fixos: ele gera uma
# credencial que EXPIRA, no formato da TURN REST API:
#     usuario  = "<timestamp de expiracao>:<rotulo>"
#     senha    = base64( HMAC-SHA1( TURN_SECRET , usuario ) )
# O segredo compartilhado nunca sai do servidor, e o coturn precisa do MESMO
# valor em `static-auth-secret` (veja infra/coturn/turnserver.conf).
#
# Gere com:  openssl rand -hex 32
#
# Se TURN_SECRET ficar vazio, o projeto usa TURN_USERNAME/TURN_CREDENTIAL
# (modo estatico, sem expiracao) e DECLARA isso em `turn.credentialMode`.
TURN_SECRET=
# Validade da credencial efemera, em segundos (padrao 3600).
TURN_TTL_SECONDS=3600
# Segredo usado para assinar o token de acesso a LIVE (JWT HS256)
LIVE_TOKEN_SECRET=
# Numero maximo de espectadores simultaneos por LIVE
LIVE_MAX_VIEWERS=500
# Numero maximo de participantes numa malha WebRTC (host + espectadores)
LIVE_MAX_PEERS=13

# --- GIPHY (GIFs e stickers) ---------------------------------------------
# Obrigatorio para habilitar GIF/sticker. Obtenha em https://developers.giphy.com
# Sem esta chave o endpoint /api/giphy responde 503 GIF_PROVIDER_NOT_CONFIGURED
GIPHY_API_KEY=
GIPHY_BASE_URL=https://api.giphy.com

# --- Push notifications (Web Push / VAPID) --------------------------------
# Gere com: npm run keys (gera par de chaves VAPID em .env)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# --- Seguranca ------------------------------------------------------------
# Limite global de requisicoes por janela (rate limit)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
# Bloqueia registro/login apos N tentativas em 15 minutos
AUTH_MAX_ATTEMPTS=8
AUTH_ATTEMPT_WINDOW_MS=900000

# --- Administracao -------------------------------------------------------
# Seed seguro: cria o primeiro admin somente com estas variaveis
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Apenas para seed local de demonstracao (`npm run seed -- --demo`); minimo 12 caracteres.
DEMO_PASSWORD=

# --- Segredos do YouTube (opcional, para links de deep link) --------------
YOUTUBE_API_KEY=
