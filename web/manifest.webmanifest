    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Feed Para voce", "short_name": "Feed", "url": "/", "description": "Abrir o feed vertical" },
    { "name": "Inbox", "short_name": "Inbox", "url": "/inbox", "description": "Abrir as mensagens" },
